{
  "name": "@post-cortex/plugin-core",
  "version": "0.1.0",
  "description": "Shared core of the post-cortex native plugins: client config, project resolution, REST client and the text the agent sees",
  "license": "MIT",
  "author": "Chronicle Labs Ltd.",
  "homepage": "https://post-cortex.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julymetodiev/post-cortex.git",
    "directory": "integrations/js/core"
  },
  "bugs": "https://github.com/julymetodiev/post-cortex/issues",
  "keywords": [
    "post-cortex",
    "memory",
    "agents",
    "mcp",
    "plugin"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test build-test/test/*.test.js",
    "clean": "rm -rf dist build-test"
  }
}
