{
  "name": "@post-cortex/openclaw",
  "version": "0.1.0",
  "description": "post-cortex memory for OpenClaw: user and project cards in the system prompt, optional turn capture, the post-cortex MCP server",
  "license": "MIT",
  "author": "Chronicle Labs Ltd.",
  "homepage": "https://post-cortex.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julymetodiev/post-cortex.git",
    "directory": "integrations/js/openclaw"
  },
  "bugs": "https://github.com/julymetodiev/post-cortex/issues",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "post-cortex",
    "memory",
    "mcp",
    "agents"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/plugin.js",
    "dist/plugin.d.ts",
    "openclaw.plugin.json",
    "assets/icon.png",
    "README.md"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.5"
    },
    "build": {
      "openclawVersion": "2026.10.5",
      "pluginSdkVersion": "2026.10.5"
    },
    "install": {
      "npmSpec": "@post-cortex/openclaw"
    }
  },
  "engines": {
    "node": ">=24.16"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test build-test/test/*.test.js",
    "clean": "rm -rf dist build-test"
  },
  "dependencies": {
    "@post-cortex/plugin-core": "0.1.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.5"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "openclaw": "2026.11.5"
  }
}
