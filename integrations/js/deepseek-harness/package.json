{
  "name": "@post-cortex/dsh",
  "version": "0.1.1",
  "description": "post-cortex memory for DeepSeek Harness (dsh), as a native Cordis plugin: cards in the prompt, file memory after edits, optional turn capture",
  "license": "MIT",
  "author": "Chronicle Labs Ltd.",
  "homepage": "https://post-cortex.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julymetodiev/post-cortex.git",
    "directory": "integrations/js/deepseek-harness"
  },
  "bugs": "https://github.com/julymetodiev/post-cortex/issues",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "post-cortex",
    "memory",
    "mcp",
    "agents"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/plugin.js",
    "dist/plugin.d.ts",
    "cordis.patch.yml",
    "icon.png",
    "README.md",
    "skills/"
  ],
  "icon": "./icon.png",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.4 <0.3.0-0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test build-test/test/*.test.js",
    "clean": "rm -rf dist build-test"
  },
  "dependencies": {
    "@post-cortex/plugin-core": "0.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.4 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.4 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.4 <0.3.0-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.2-rc.4 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.4 <0.3.0-0",
    "@deepseek-ai/dsh-skill": ">=0.2.2-rc.4 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.4",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.4",
    "@deepseek-ai/dsh-session": "0.2.2-rc.4",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.4",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.4",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.4"
  }
}
