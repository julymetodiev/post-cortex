      "service": "github",
      "name": "github-issues-list",
      "description": "The issues of a repository of GitHub (pull requests among them), the newest first.",
      "method": "GET",
      "path": "/repos/{owner}/{repo}/issues",
      "params": [
        {
          "name": "owner",
          "in": "PLACE_PATH",
          "type": "string",
          "description": "The repository's owner: a user or an organisation.",
          "example": {
            "string": "octocat"
          },
          "required": true
        },
        {
          "name": "repo",
          "in": "PLACE_PATH",
          "type": "string",
          "description": "The repository's name.",
          "example": {
            "string": "hello-world"
          },
          "required": true
        },
        {
          "name": "state",
          "in": "PLACE_QUERY",
          "type": "string",
          "description": "open, closed or all.",
          "example": {
            "string": "open"
          },
          "required": false
        },
        {
          "name": "per_page",
          "in": "PLACE_QUERY",
          "type": "int",
          "description": "How many, at most 100.",
          "example": {
            "int": 30
          },
          "required": false
        }
      ],
      "response": {
        "fields": [
          {
            "name": "number",
            "type": "int",
            "description": "The issue's number.",
            "required": true
          },
          {
            "name": "title",
            "type": "string",
            "description": "Its title.",
            "required": true
          },
          {
            "name": "state",
            "type": "string",
            "description": "open or closed.",
            "required": true
          },
          {
            "name": "html_url",
            "type": "string",
            "description": "Its page.",
            "required": true
          }
        ]
      },
      "response_list": true
    },
