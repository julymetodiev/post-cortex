    {
      "connection": "slack",
      "base_url": "https://slack.com/api",
      "auth": "AUTH_BEARER",
      "service": "slack",
      "name": "slack-message-post",
      "description": "Post a message to a channel of Slack (chat.postMessage). Slack answers 200 with ok false on a failure: read ok.",
      "method": "POST",
      "path": "/chat.postMessage",
      "params": [
        {
          "name": "channel",
          "in": "PLACE_BODY",
          "type": "string",
          "description": "The channel's id or name.",
          "example": {
            "string": "C0123456789"
          },
          "required": true
        },
        {
          "name": "text",
          "in": "PLACE_BODY",
          "type": "string",
          "description": "The message.",
          "example": {
            "string": "The deploy is done."
          },
          "required": true
        }
      ],
      "response": {
        "fields": [
          {
            "name": "ok",
            "type": "bool",
            "description": "Whether Slack took it.",
            "required": true
          },
          {
            "name": "ts",
            "type": "string",
            "description": "The message's time stamp.",
            "required": false
          },
          {
            "name": "error",
            "type": "string",
            "description": "Why not, when not.",
            "required": false
          }
        ]
      }
    },
