    },
    {
      "connection": "github",
      "base_url": "https://api.github.com",
      "auth": "AUTH_BEARER",
      "headers": [
        {
          "name": "Accept",
          "value": "application/vnd.github+json"
        },
        {
          "name": "X-GitHub-Api-Version",
          "value": "2022-11-28"
        }
      ],
      "service": "github",
      "name": "github-repo-get",
      "description": "A repository of GitHub.",
      "method": "GET",
      "path": "/repos/{owner}/{repo}",
      "params": [
        {
          "name": "owner",
          "in": "PLACE_PATH",
          "type": "string",
          "description": "The repository's owner: a user or an organisation.",
          "example": {
            "string": "octocat"
          },
          "required": true
        },
        {
          "name": "repo",
          "in": "PLACE_PATH",
          "type": "string",
          "description": "The repository's name.",
          "example": {
            "string": "hello-world"
          },
          "required": true
        }
      ],
      "response": {
        "fields": [
          {
            "name": "full_name",
            "type": "string",
            "description": "owner/name.",
            "required": true
          },
          {
            "name": "private",
            "type": "bool",
            "description": "Whether it is private.",
            "required": true
          },
          {
            "name": "stargazers_count",
            "type": "int",
            "description": "Its stars.",
            "required": true
          },
          {
            "name": "default_branch",
            "type": "string",
            "description": "Its default branch.",
            "required": true
          },
          {
            "name": "html_url",
            "type": "string",
            "description": "Its page.",
            "required": true
          }
        ]
      }
    },
