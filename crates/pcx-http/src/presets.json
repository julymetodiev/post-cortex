{
  "presets": [
    {
      "name": "rest-get",
      "service": "rest",
      "description": "A GET of a JSON API: set the path (and the connection) to what you call.",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "rest-post-json",
      "service": "rest",
      "description": "A POST of a JSON body to an API: set the path, the connection and the body.",
      "method": "POST",
